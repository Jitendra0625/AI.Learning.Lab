{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "logging": {
    //"logLevel": {
    //  "default": "Information",
    //  "OmniGuard": "Information",
    //  "Microsoft.Azure.Functions.Worker": "Warning"
    //},
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "serviceBus": {
      "maxConcurrentCalls": 2,
      "autoCompleteMessages": true
    }
  }
}